#!/usr/bin/env python3
"""
paynani CLI.

    paynani onboard [--port PORT]
    paynani set KEY [VALUE] [--skip-check]
    paynani status [--json]
    paynani event show EVENT_ID [--body]
    paynani event list [--limit N]
    paynani event mark EVENT_ID STATE
    paynani roster list
    paynani roster explain --from ADDRESS [--header NAME=VALUE]
    paynani roster add NAME ADDRESS [--type TYPE] [--github HANDLE] [--yes]
    paynani roster remove ADDRESS [--yes]
    paynani paths [--json]
    paynani doctor [--json]
    paynani support-bundle --output DIR

`onboard` starts the mailbox onboarding flow: a local, loopback-only web
server prints a one-time link, a human fills in the seven mailbox settings,
and the CLI writes .env once both IMAP and SMTP authenticate for real. It
replaced an earlier PHP form retired in favor of this command (see
CHANGELOG.md); issue #114 has the PRD and why this exists (an agent host
frequently has no PHP CLI, and cannot install one without sudo, while every
other part of paynani already requires only Python 3's standard library).

`set` and `roster` are issue #116's follow-up to that PRD: changing one .env
key, or one roster.md contact, without hand-editing either file or re-running
the whole onboarding flow for a single value.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from paynani_lib import (  # noqa: E402
    diagnostics, event_cli, i18n, onboard, roster_cli, set_cli, status_cli,
)

DEFAULT_PORT = 8765


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="paynani", description="paynani CLI.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    onboard_parser = subparsers.add_parser(
        "onboard", help="Start the mailbox onboarding web form and write .env."
    )
    onboard_parser.add_argument(
        "--port",
        type=int,
        default=DEFAULT_PORT,
        help=f"Port to bind on 127.0.0.1 (default: {DEFAULT_PORT}).",
    )

    set_parser = subparsers.add_parser(
        "set", help="Set one .env key, with a live IMAP/SMTP check by default."
    )
    set_parser.add_argument("key", help="One of the seven keys .env owns, e.g. AGENT_EMAIL_PASSWORD.")
    set_parser.add_argument("value", nargs="?", help="New value. Omit to be prompted (hidden for the password).")
    set_parser.add_argument(
        "--skip-check",
        action="store_true",
        help="Write without re-verifying against the mail server first.",
    )

    roster_parser = subparsers.add_parser("roster", help="Manage roster.md.")
    roster_sub = roster_parser.add_subparsers(dest="roster_command", required=True)

    roster_sub.add_parser("list", help="Print the current contacts.")

    roster_explain = roster_sub.add_parser(
        "explain", help="Explain whether a From/header combination matches the roster."
    )
    roster_explain.add_argument("--from", dest="from_address", required=True)
    roster_explain.add_argument(
        "--header", action="append", default=[], metavar="NAME=VALUE",
        help="Add a provider header; may be repeated.",
    )

    roster_add = roster_sub.add_parser("add", help="Add a contact.")
    roster_add.add_argument("name")
    roster_add.add_argument("address")
    roster_add.add_argument("--type", help='e.g. "Human" or "AI Agent" (only if roster.md has a Type column).')
    roster_add.add_argument("--github", help="GitHub login (only if roster.md has a GitHub column).")
    roster_add.add_argument("--yes", action="store_true", help="Write without an interactive confirmation.")

    roster_remove = roster_sub.add_parser("remove", help="Remove a contact by address.")
    roster_remove.add_argument("address")
    roster_remove.add_argument("--yes", action="store_true", help="Write without an interactive confirmation.")

    event_parser = subparsers.add_parser("event", help="Inspect and update event lifecycle state.")
    event_sub = event_parser.add_subparsers(dest="event_command", required=True)
    event_show = event_sub.add_parser("show", help="Show a safe envelope; fetch body only with --body.")
    event_show.add_argument("event_id")
    event_show.add_argument("--body", action="store_true", help="Fetch the exact IMAP body after roster verification.")
    event_list = event_sub.add_parser("list", help="List recent canonical events and lifecycle state.")
    event_list.add_argument("--limit", type=int, default=20)
    event_mark = event_sub.add_parser("mark", help="Append a handled/replied/closed transition.")
    event_mark.add_argument("event_id")
    event_mark.add_argument("state", choices=("handled", "replied", "closed"))
    event_mark.add_argument("--runtime")
    event_mark.add_argument("--detail")

    status_parser = subparsers.add_parser("status", help="Show event lifecycle and Codex delivery status.")
    status_parser.add_argument("--json", action="store_true")

    paths_parser = subparsers.add_parser("paths", help="Print resolved paynani paths.")
    paths_parser.add_argument("--json", action="store_true", help="machine-readable output")

    doctor_parser = subparsers.add_parser("doctor", help="Diagnose this install with ok/warning/blocked/unknown statuses.")
    doctor_parser.add_argument("--json", action="store_true", help="machine-readable output")

    bundle_parser = subparsers.add_parser("support-bundle", help="Write a redacted support bundle.")
    bundle_parser.add_argument("--output", required=True, help="Directory to create or update with redacted diagnostics.")

    args = parser.parse_args(argv)

    # `set` and `roster` are terminal commands whose own strings are English,
    # but i18n.LANG_DEFAULT is es-MX (right for onboard's web form, which
    # negotiates per-request) and nothing else ever calls set_current() — so
    # a message from validate.py reached the terminal in Spanish inside an
    # English sentence. onboard is untouched here: server.py sets the
    # language itself on every request, before this default could matter.
    if args.command in ("set", "roster", "event", "status"):
        i18n.set_current("en-US")

    if args.command == "onboard":
        return onboard.run(port=args.port)
    if args.command == "set":
        return set_cli.run(args)
    if args.command == "roster":
        if args.roster_command == "list":
            return roster_cli.run_list(args)
        if args.roster_command == "add":
            return roster_cli.run_add(args)
        if args.roster_command == "remove":
            return roster_cli.run_remove(args)
        if args.roster_command == "explain":
            return roster_cli.run_explain(args)
    if args.command == "event":
        if args.event_command == "show":
            return event_cli.run_show(args)
        if args.event_command == "list":
            return event_cli.run_list(args)
        if args.event_command == "mark":
            return event_cli.run_mark(args)
    if args.command == "status":
        return status_cli.run(args)
    if args.command == "paths":
        return diagnostics.print_paths(args.json)
    if args.command == "doctor":
        return diagnostics.print_doctor(args.json)
    if args.command == "support-bundle":
        out = diagnostics.support_bundle(args.output)
        print(f"wrote redacted support bundle to {out}")
        return 0

    parser.print_help()
    return 64


if __name__ == "__main__":
    raise SystemExit(main())
