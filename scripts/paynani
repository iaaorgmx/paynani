#!/usr/bin/env python3
"""
paynani CLI.

    paynani setup [--port PORT]
    paynani onboard [--port PORT]
    paynani config
    paynani config web [--port PORT]
    paynani config edit
    paynani set KEY [VALUE] [--skip-check]
    paynani status [--json]
    paynani event show EVENT_ID [--body]
    paynani event list [--limit N]
    paynani event mark EVENT_ID STATE
    paynani roster list
    paynani roster explain --from ADDRESS [--header NAME=VALUE]
    paynani roster migrate --plan|--apply [--yes]
    paynani roster apply --file CONTACTS.json [--dry-run] [--yes]
    paynani roster add NAME ADDRESS [--type TYPE] [--github HANDLE] [--phone NUMBER] [--roster PATH] [--yes]
    paynani roster remove ADDRESS [--roster PATH] [--yes]
    paynani paths [--json]
    paynani doctor [--json]
    paynani support-bundle --output DIR
    paynani openclaw probe --dry-run
    paynani account list
    paynani account test ID
    paynani account add ID --email ADDRESS --imap-host HOST [--imap-port N] [--smtp-host HOST] [--smtp-port N] [--from-name NAME] [--mailbox NAME]...
    paynani account remove ID [--yes]
    paynani web user add --email ADDRESS --name NAME [--password-stdin]
    paynani web user show
    paynani web passwd [--password-stdin]

`onboard` starts the mailbox onboarding flow: a local, loopback-only web
server prints a one-time link, a human fills in the seven mailbox settings,
and the CLI writes .env once both IMAP and SMTP authenticate for real. It
replaced an earlier PHP form retired in favor of this command (see
CHANGELOG.md); issue #114 has the PRD and why this exists (an agent host
frequently has no PHP CLI, and cannot install one without sudo, while every
other part of paynani already requires only Python 3's standard library).

`set` and `roster` are issue #116's follow-up to that PRD: changing one .env
key, or one roster.md contact, without hand-editing either file or re-running
the whole onboarding flow for a single value.

`setup` (#232) is the discoverable name for `onboard` -- same command, kept
as a working alias since INSTALL.md, MAILBOX_SETUP.md and several fleet
agents' own notes already say `onboard`. `config` prints what is currently
set; `config web` reuses the same setup server to edit it in a browser;
`config edit` opens .env directly in $EDITOR and is for a human only --
AGENTS.md says why, and `paynani set` is what an agent uses instead.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from paynani_lib import (  # noqa: E402
    accounts_cli, config_cli, diagnostics, event_cli, i18n, onboard,
    openclaw_cli, roster_cli, set_cli, status_cli,
)

DEFAULT_PORT = 8765


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else list(argv)
    parser = argparse.ArgumentParser(prog="paynani", description="paynani CLI.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    onboard_parser = subparsers.add_parser(
        "onboard", help="Start the mailbox onboarding web form and write .env."
    )
    onboard_parser.add_argument(
        "--port",
        type=int,
        default=DEFAULT_PORT,
        help=f"Port to bind on 127.0.0.1 (default: {DEFAULT_PORT}).",
    )

    setup_parser = subparsers.add_parser(
        "setup", help="Start the mailbox setup web form and write .env. Same as `onboard`."
    )
    setup_parser.add_argument(
        "--port",
        type=int,
        default=DEFAULT_PORT,
        help=f"Port to bind on 127.0.0.1 (default: {DEFAULT_PORT}).",
    )

    config_parser = subparsers.add_parser(
        "config", help="Print the current .env configuration."
    )
    config_sub = config_parser.add_subparsers(dest="config_command", required=False)
    config_web = config_sub.add_parser(
        "web", help="Open the setup form in a browser to edit .env."
    )
    config_web.add_argument(
        "--port",
        type=int,
        default=DEFAULT_PORT,
        help=f"Port to bind on 127.0.0.1 (default: {DEFAULT_PORT}).",
    )
    config_sub.add_parser(
        "edit", help="Open .env in $EDITOR. Human only -- an agent uses `paynani set`."
    )

    set_parser = subparsers.add_parser(
        "set", help="Set one .env key, with a live IMAP/SMTP check by default."
    )
    set_parser.add_argument("key", help="One supported .env key, e.g. AGENT_EMAIL_PASSWORD or PAYNANI_SIGNATURE_FILE.")
    set_parser.add_argument("value", nargs="?", help="New value. Omit to be prompted (hidden for the password).")
    set_parser.add_argument(
        "--skip-check",
        action="store_true",
        help="Write without re-verifying against the mail server first.",
    )

    roster_parser = subparsers.add_parser("roster", help="Manage roster.md.")
    roster_sub = roster_parser.add_subparsers(dest="roster_command", required=True)

    roster_sub.add_parser("list", help="Print the current contacts.")

    roster_explain = roster_sub.add_parser(
        "explain", help="Explain whether a From/header combination matches the roster."
    )
    roster_explain.add_argument("--from", dest="from_address", required=True)
    roster_explain.add_argument(
        "--header", action="append", default=[], metavar="NAME=VALUE",
        help="Add a provider header; may be repeated.",
    )

    roster_migrate = roster_sub.add_parser("migrate", help="Plan or apply legacy roster schema migration.")
    migrate_mode = roster_migrate.add_mutually_exclusive_group(required=True)
    migrate_mode.add_argument("--plan", action="store_true", help="Show what would change.")
    migrate_mode.add_argument("--apply", action="store_true", help="Write the migration after tests pass.")
    roster_migrate.add_argument(
        "--yes", action="store_true", help="Write without an interactive confirmation."
    )

    roster_apply = roster_sub.add_parser("apply", help="Apply a JSON batch of contacts atomically.")
    roster_apply.add_argument("--file", required=True, help="JSON file with a contacts array, or a top-level array.")
    roster_apply.add_argument("--dry-run", action="store_true", help="Validate and print the logical diff without writing.")
    roster_apply.add_argument("--yes", action="store_true", help="Write without an interactive confirmation.")
    roster_add = roster_sub.add_parser("add", help="Add a contact.")
    roster_add.add_argument("name")
    roster_add.add_argument("address")
    roster_add.add_argument("--type", help='e.g. "Human" or "AI Agent" (only if roster.md has a Type column).')
    roster_add.add_argument("--github", help="GitHub login (only if roster.md has a GitHub column).")
    roster_add.add_argument("--phone", help="Phone number(s), comma separated, for SMS (only if roster.md has a Phone column). Stored in E.164.")
    roster_add.add_argument("--yes", action="store_true", help="Write without an interactive confirmation.")
    roster_add.add_argument("--roster", help="An additional account's roster, as `paynani account add` prints it "
                                             "(e.g. rosters/ventas.md). Default: roster.md.")

    roster_remove = roster_sub.add_parser("remove", help="Remove a contact by address.")
    roster_remove.add_argument("address")
    roster_remove.add_argument("--yes", action="store_true", help="Write without an interactive confirmation.")
    roster_remove.add_argument("--roster", help="An additional account's roster, as `paynani account add` prints it "
                                                "(e.g. rosters/ventas.md). Default: roster.md.")

    event_parser = subparsers.add_parser("event", help="Inspect and update event lifecycle state.")
    event_sub = event_parser.add_subparsers(dest="event_command", required=True)
    event_show = event_sub.add_parser("show", help="Show a safe envelope; fetch body only with --body.")
    event_show.add_argument("event_id")
    event_show.add_argument("--body", action="store_true", help="Fetch the exact IMAP body after roster verification.")
    event_list = event_sub.add_parser("list", help="List recent canonical events and lifecycle state.")
    event_list.add_argument("--limit", type=int, default=20)
    event_mark = event_sub.add_parser("mark", help="Append a handled/replied/closed transition.")
    event_mark.add_argument("event_id")
    event_mark.add_argument("state", choices=("handled", "replied", "closed"))
    event_mark.add_argument("--runtime")
    event_mark.add_argument("--detail")

    status_parser = subparsers.add_parser("status", help="Show event lifecycle and Codex delivery status.")
    status_parser.add_argument("--json", action="store_true")

    paths_parser = subparsers.add_parser("paths", help="Print resolved paynani paths.")
    paths_parser.add_argument("--json", action="store_true", help="machine-readable output")

    doctor_parser = subparsers.add_parser("doctor", help="Diagnose this install with ok/warning/blocked/unknown statuses.")
    doctor_parser.add_argument("--json", action="store_true", help="machine-readable output")

    bundle_parser = subparsers.add_parser("support-bundle", help="Write a redacted support bundle.")
    bundle_parser.add_argument("--output", required=True, help="Directory to create or update with redacted diagnostics.")

    openclaw_parser = subparsers.add_parser("openclaw", help="OpenClaw-specific utilities.")
    openclaw_sub = openclaw_parser.add_subparsers(dest="openclaw_command", required=True)
    openclaw_probe = openclaw_sub.add_parser("probe", help="Send a synthetic OpenClaw route probe.")
    openclaw_probe.add_argument(
        "--dry-run",
        action="store_true",
        help="Use a synthetic probe event, not mail or the paynani journal.",
    )

    sms_parser = subparsers.add_parser("sms", help="SMS gateway: pair, show or revoke the phone (SMS_GATEWAY.md).")
    sms_sub = sms_parser.add_subparsers(dest="sms_command", required=True)
    sms_pair = sms_sub.add_parser("pair", help="Print a one-time pairing code and the QR payload.")
    sms_pair.add_argument("--url", default="", help="Public tunnel URL (or PAYNANI_SMS_PUBLIC_URL).")
    sms_pair.add_argument("--replace", action="store_true", help="Revoke the paired phone first.")
    sms_pair.add_argument("--web", action="store_true", help="Open the pairing page (QR, paired phone, revoke) in a browser instead of printing the code.")
    sms_pair.add_argument("--port", type=int, default=8765, help="Port for --web (default 8765).")
    sms_sub.add_parser("devices", help="Show the paired phone, without its token.")
    sms_sub.add_parser("revoke", help="Revoke the paired phone.")
    sms_send = sms_sub.add_parser("send", help="Send an SMS to a roster contact through the paired phone.")
    sms_send.add_argument("number", help="Recipient phone number; it must be in roster.md.")
    sms_send.add_argument("text", nargs="+", help="Message text (max 1000 characters).")
    sms_send.add_argument("--wait", type=int, default=20, help="Seconds to wait for the phone's status (default 20; 0 returns at once); exit 3 if no final status arrived in time.")
    sms_send.add_argument("--ttl", type=int, default=15, help="Minutes the order may wait for a connected phone (default 15).")
    sms_send.add_argument("--sim", type=int, default=None, help="SIM slot to send from.")
    sms_send.add_argument("--override-pause", action="store_true", help="Send even though the phone's owner replied to this number recently (exit 4 otherwise). Only when the owner asked for it.")
    sms_send.add_argument("--override", help="Send even though this contact's rules say reply.sms: never (exit 2 otherwise). Only on the owner's explicit order; logged with --override-by.")
    sms_send.add_argument("--override-by", help="Who gave the order for --override (the owner, and how).")
    sms_thread = sms_sub.add_parser("thread", help="Show the conversation with a number: received SMS, the agent's orders and the owner's replies from PaynaniApp.")
    sms_thread.add_argument("number", help="The other party's phone number.")
    sms_thread.add_argument("--limit", type=int, default=0, help="Show only the last N messages (default all).")
    sms_status = sms_sub.add_parser("status", help="Show the states of an SMS order.")
    sms_status.add_argument("order_id")
    sms_check = sms_sub.add_parser("check", help="Check gateway, tunnel and phone; with --to, send a test text and wait for the reply.")
    sms_check.add_argument("--to", default="", help="A roster number to send a test text to.")
    sms_check.add_argument("--wait", type=int, default=60, help="Seconds to wait for the phone to send the test text (default 60).")
    sms_check.add_argument("--wait-reply", type=int, default=0, help="Seconds to wait for a reply from --to (default 0: do not wait).")

    wa_parser = subparsers.add_parser("whatsapp", help="WhatsApp: link, status, send and threads (WHATSAPP_BRIDGE.md).")
    wa_sub = wa_parser.add_subparsers(dest="wa_command", required=True)
    wa_status = wa_sub.add_parser("status", help="Show the WhatsApp state, the linked number and any linking in progress.")
    wa_status.add_argument("--json", action="store_true", help="Print the service's answer as JSON.")
    wa_link = wa_sub.add_parser("link", help="Link WhatsApp: a QR in the terminal, or a code with --code --number.")
    wa_link.add_argument("--code", action="store_true", help="Link with a code typed on the phone instead of a QR.")
    wa_link.add_argument("--number", help="With --code: the phone's own number, E.164.")
    wa_unlink = wa_sub.add_parser("unlink", help="Unlink WhatsApp and delete the keys in state/whatsapp/auth/.")
    wa_unlink.add_argument("--yes", action="store_true", help="Do not ask for confirmation.")
    wa_send = wa_sub.add_parser("send", help="Reply on WhatsApp to a roster contact who wrote first (exit 2 if not allowed).")
    wa_send.add_argument("number", help="Recipient number; it must be in roster.md and have written since linking.")
    wa_send.add_argument("text", nargs="*", help="Message text (max 4000 characters).")
    wa_send.add_argument("--file", help="A file inside state/whatsapp/outbox/ or WHATSAPP_ATTACH_DIRS.")
    wa_send.add_argument("--by", choices=("agent", "terminal"), default="agent", help="Who sends, as shown in the thread (default agent).")
    wa_thread = wa_sub.add_parser("thread", help="Show the WhatsApp conversation with a number.")
    wa_thread.add_argument("number")
    wa_thread.add_argument("--limit", type=int, default=50, help="Messages to show (1 to 100, default 50).")
    wa_thread.add_argument("--json", action="store_true", help="Print the service's answer as JSON.")

    tg_parser = subparsers.add_parser("telegram", help="Telegram bot: setup, status and token change (TELEGRAM.md).")
    tg_sub = tg_parser.add_subparsers(dest="tg_command", required=True)
    tg_setup = tg_sub.add_parser("setup", help="Save the bot token (read from stdin) to telegram.env, after getMe.")
    tg_setup.add_argument("--dedicated", action="store_true", help="Confirm the token is only for this install.")
    tg_setup.add_argument("--delete-webhook", action="store_true", help="Confirm deleting a webhook if the bot has one.")
    tg_setup.add_argument("--replace", action="store_true", help="Replace a configured token while the service is stopped.")
    tg_status = tg_sub.add_parser("status", help="Show the state of paynani-telegram and the bot's @username.")
    tg_status.add_argument("--json", action="store_true", help="Print the service's answer as JSON.")
    tg_token = tg_sub.add_parser("token", help="Change the bot token (read from stdin) with rollback if it does not work.")
    tg_token.add_argument("--dedicated", action="store_true", help="Confirm the token is only for this install.")
    tg_token.add_argument("--delete-webhook", action="store_true", help="Confirm deleting a webhook if the new bot has one.")
    tg_send = tg_sub.add_parser("send", help="Reply to a roster contact who already wrote to the bot (FR-20, FR-22).")
    tg_send.add_argument("contact", help="The contact's name or email in roster.md.")
    tg_send.add_argument("text", nargs="*", help="The message; without it (and without --file), read from stdin.")
    tg_send.add_argument("--file", help="A file from state/telegram/outbox/ or TELEGRAM_ATTACH_DIRS.")
    tg_send.add_argument("--stream", action="store_true", help="Read stdin as it arrives and show it while it is written.")
    tg_draft = tg_sub.add_parser("draft", help="Show a progress draft that the next send replaces (FR-24).")
    tg_draft.add_argument("contact")
    tg_draft.add_argument("text", nargs="+")
    tg_threads = tg_sub.add_parser("threads", help="List the Telegram conversations, newest first.")
    tg_threads.add_argument("--limit", type=int, default=50, help="Conversations to show (1 to 100, default 50).")
    tg_threads.add_argument("--json", action="store_true", help="Print the service's answer as JSON.")
    tg_thread = tg_sub.add_parser("thread", help="Show the conversation with a roster contact (FR-27).")
    tg_thread.add_argument("contact")
    tg_thread.add_argument("--limit", type=int, default=50, help="Messages to show (1 to 100, default 50).")
    tg_thread.add_argument("--json", action="store_true", help="Print the service's answer as JSON.")
    tg_sub.add_parser("disable", help="Turn Telegram off (TELEGRAM_ENABLED=0) and stop the service; keeps the token.")
    tg_sub.add_parser("enable", help="Turn Telegram back on with the token in telegram.env and start the service.")

    account_parser = subparsers.add_parser(
        "account", help="Additional mail accounts in accounts.json (#276)."
    )
    account_sub = account_parser.add_subparsers(dest="account_command", required=True)
    account_sub.add_parser("list", help="List the additional accounts, without secrets.")
    account_test = account_sub.add_parser(
        "test", help="Log in, open each mailbox and check IDLE for one account."
    )
    account_test.add_argument("account_id")
    account_add = account_sub.add_parser(
        "add",
        help="Add a mail account: tests the login first, then writes accounts.json, "
             "the .env, a roster and the himalaya account.",
    )
    account_add.add_argument("id", help="Short id: lowercase letters, digits, dashes.")
    account_add.add_argument("--email", required=True, help="The account's address.")
    account_add.add_argument("--imap-host", required=True)
    account_add.add_argument("--imap-port", type=int, default=993)
    account_add.add_argument("--smtp-host", help="Needed to send from this account; omit to only read it.")
    account_add.add_argument("--smtp-port", type=int, default=465)
    account_add.add_argument("--from-name", help="Display name on mail sent from this account.")
    account_add.add_argument(
        "--mailbox", action="append",
        help="Mailbox to watch (repeatable; default INBOX).",
    )
    account_remove = account_sub.add_parser(
        "remove",
        help="Remove an account: stops its service and drops it from accounts.json, the .env "
             "and himalaya. Its roster is moved to rosters/removed/, never deleted.",
    )
    account_remove.add_argument("id")
    account_remove.add_argument("--yes", action="store_true", help="Do not ask for confirmation.")

    web_parser = subparsers.add_parser(
        "web", help="PaynaniWeb, the web app to manage paynani (PRD #434): its one user."
    )
    web_sub = web_parser.add_subparsers(dest="web_command", required=True)
    web_user = web_sub.add_parser("user", help="The PaynaniWeb user: the owner of this install.")
    web_user_sub = web_user.add_subparsers(dest="web_user_command", required=True)
    web_user_add = web_user_sub.add_parser(
        "add", help="Create the PaynaniWeb user. Asks for the password twice; only its scrypt hash is kept.")
    web_user_add.add_argument("--email", required=True, help="The owner's address: what they sign in with.")
    web_user_add.add_argument("--name", required=True, help="The owner's name, shown in Profile.")
    web_user_add.add_argument("--password-stdin", action="store_true",
                              help="Read the password from one line of stdin instead of asking.")
    web_user_sub.add_parser("show", help="Show the PaynaniWeb user, without the password hash.")
    web_passwd = web_sub.add_parser("passwd", help="Change the PaynaniWeb user's password.")
    web_passwd.add_argument("--password-stdin", action="store_true",
                            help="Read the new password from one line of stdin instead of asking.")

    if argv == [] or argv == ["help"]:
        parser.print_help()
        return 0

    args = parser.parse_args(argv)

    # `set` and `roster` are terminal commands whose own strings are English,
    # but i18n.LANG_DEFAULT is es-MX (right for onboard's web form, which
    # negotiates per-request) and nothing else ever calls set_current() — so
    # a message from validate.py reached the terminal in Spanish inside an
    # English sentence. onboard is untouched here: server.py sets the
    # language itself on every request, before this default could matter.
    if args.command in ("set", "roster", "event", "status", "config", "account"):
        i18n.set_current("en-US")

    if args.command == "onboard":
        return onboard.run(port=args.port, mode="setup")
    if args.command == "setup":
        return onboard.run(port=args.port, mode="setup")
    if args.command == "config":
        if args.config_command is None:
            return config_cli.run_print(args)
        if args.config_command == "web":
            return config_cli.run_web(args)
        if args.config_command == "edit":
            return config_cli.run_edit(args)
    if args.command == "set":
        return set_cli.run(args)
    if args.command == "roster":
        if args.roster_command == "list":
            return roster_cli.run_list(args)
        if args.roster_command == "migrate":
            return roster_cli.run_migrate(args)
        if args.roster_command == "apply":
            return roster_cli.run_apply(args)
        if args.roster_command == "add":
            return roster_cli.run_add(args)
        if args.roster_command == "remove":
            return roster_cli.run_remove(args)
        if args.roster_command == "explain":
            return roster_cli.run_explain(args)
    if args.command == "event":
        if args.event_command == "show":
            return event_cli.run_show(args)
        if args.event_command == "list":
            return event_cli.run_list(args)
        if args.event_command == "mark":
            return event_cli.run_mark(args)
    if args.command == "status":
        return status_cli.run(args)
    if args.command == "paths":
        return diagnostics.print_paths(args.json)
    if args.command == "doctor":
        return diagnostics.print_doctor(args.json)
    if args.command == "support-bundle":
        out = diagnostics.support_bundle(args.output)
        print(f"wrote redacted support bundle to {out}")
        return 0
    if args.command == "account":
        if args.account_command == "list":
            return accounts_cli.run_list(args)
        if args.account_command == "test":
            return accounts_cli.run_test(args)
        if args.account_command == "add":
            return accounts_cli.run_add(args)
        if args.account_command == "remove":
            return accounts_cli.run_remove(args)
    if args.command == "web":
        from paynani_lib.web import cli as web_cli
        if args.web_command == "user" and args.web_user_command == "add":
            return web_cli.run_user_add(args)
        if args.web_command == "user" and args.web_user_command == "show":
            return web_cli.run_user_show(args)
        if args.web_command == "passwd":
            return web_cli.run_passwd(args)
    if args.command == "sms":
        from paynani_lib.sms import config as sms_config
        sms_config.load_sms_env()
        from paynani_lib.sms import cli as sms_cli
        if args.sms_command == "pair":
            if args.web:
                return onboard.run(port=args.port, mode="sms_pair")
            return sms_cli.run_pair(args)
        if args.sms_command == "devices":
            return sms_cli.run_devices(args)
        if args.sms_command == "revoke":
            return sms_cli.run_revoke(args)
        if args.sms_command == "send":
            return sms_cli.run_send(args)
        if args.sms_command == "status":
            return sms_cli.run_status(args)
        if args.sms_command == "thread":
            return sms_cli.run_thread(args)
        if args.sms_command == "check":
            from paynani_lib.sms import check as sms_check_mod
            return sms_check_mod.run(args)
    if args.command == "whatsapp":
        from paynani_lib.whatsapp import cli as wa_cli
        return {"status": wa_cli.run_status, "link": wa_cli.run_link, "unlink": wa_cli.run_unlink,
                "send": wa_cli.run_send, "thread": wa_cli.run_thread}[args.wa_command](args)
    if args.command == "telegram":
        from paynani_lib.telegram import cli as tg_cli
        return {"setup": tg_cli.run_setup, "status": tg_cli.run_status, "token": tg_cli.run_token,
                "send": tg_cli.run_send, "draft": tg_cli.run_draft, "threads": tg_cli.run_threads,
                "thread": tg_cli.run_thread, "disable": tg_cli.run_disable,
                "enable": tg_cli.run_enable}[args.tg_command](args)
    if args.command == "openclaw":
        if args.openclaw_command == "probe":
            return openclaw_cli.run_probe(args)

    parser.print_help()
    return 64


if __name__ == "__main__":
    raise SystemExit(main())
